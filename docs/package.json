{
  "name": "cdp-uploader-api-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.1"
  },
  "scripts": {
    "gen:api": "mkdir -p docs/api/uploader && docusaurus gen-api-docs all",
    "clean:api": "docusaurus clean-api-docs all",
    "start": "npm run gen:api && docusaurus start --host 0.0.0.0 --port 3100",
    "build": "npm run gen:api && docusaurus build",
    "serve": "docusaurus serve"
  },
  "dependencies": {
    "@defra/docusaurus-theme-govuk": "github:DEFRA/docusaurus-theme-govuk",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.48.0",
    "@not-govuk/header": "0.17.4",
    "accessible-autocomplete": "3.0.1",
    "docusaurus-plugin-openapi-docs": "5.2.0",
    "docusaurus-theme-openapi-docs": "5.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
